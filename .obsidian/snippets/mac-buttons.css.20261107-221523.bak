body:not(.is-mobile) .titlebar-button-container.mod-right {
  position: absolute;
  left: 8px;
  right: auto;
  gap: 8px;
  flex-direction: row;
}

body:not(.is-mobile) .titlebar-button-container.mod-right .titlebar-button {
  width: 12px;
  height: 12px;
  min-width: 12px;
  padding: 0;
  border-radius: 50%;
  color: transparent;
}

.titlebar-button.mod-close {
  order: 1;
  background: #ff5f57;
}

.titlebar-button.mod-minimize {
  order: 2;
  background: #febc2e;
}

.titlebar-button.mod-maximize {
  order: 3;
  background: #28c840;
}

.titlebar-button-container.mod-right:hover .titlebar-button {
  color: #333;
}